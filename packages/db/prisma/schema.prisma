// ─── Prisma Schema ─── Bin Tracking System ────────────────────────
// All review issues resolved (v2 plan)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────

enum FacilityType {
  PROCESSING
  RENDERING
}

enum BinStatus {
  IDLE
  ACTIVE
  IN_TRANSIT
}

enum CycleStatus {
  ACTIVE
  IN_TRANSIT
  COMPLETED
}

enum ComplianceResult {
  ON_TIME
  LATE
}

enum Urgency {
  CRITICAL
  MEDIUM
  STANDARD
  LOW
}

enum EventType {
  BIN_STARTED
  PICKED_UP
  DELIVERED
}

enum UserRole {
  ADMIN
  OPS_MANAGER
  DRIVER
  WORKER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

enum ShipmentCondition {
  GOOD
  DAMAGED
}

enum FormType {
  standard
  checklist
  matrix
  repeating
}

enum FormTriggerType {
  on_arrival
  on_cycle_start
  scheduled
  manual
  inspection
  other
}

enum FormFillFrequency {
  per_animal
  per_shift
  daily
  weekly
  as_needed
}

// ─── Organizations / Tenancy ──────────────────────────────────────

enum Plan {
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  invitations  Invitation[]
  subscription Subscription?

  facilities          Facility[]
  binTypes            BinType[]
  bins                Bin[]
  binCycles           BinCycle[]
  employees           Employee[]
  shipments           Shipment[]
  formTemplates       FormTemplate[]
  animalRegistrations AnimalRegistration[]
  settings            Settings?
  payrollRuns         PayrollRun[]
  modules             OrganizationModule[]

  @@map("organizations")
}

model OrganizationMember {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      UserRole
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id         String    @id @default(cuid())
  orgId      String
  email      String
  role       UserRole
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("invitations")
}

model Subscription {
  id                   String             @id @default(cuid())
  orgId                String             @unique
  stripeCustomerId     String?            @unique // null until first checkout — row exists from org provisioning
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?
  // Stripe `event.created` of the last webhook applied to this row. Stripe
  // does NOT guarantee delivery order — a retried older event must never
  // overwrite state written by a newer one (billing.service.ts skips it).
  lastStripeEventAt    DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum ModuleKey {
  ANIMAL_INTAKE
  WORKFORCE
  SHIPMENTS
  FORMS
  FORMS_AI_DIGITIZE
  BLOCKCHAIN_ANCHOR
  PAYROLL
}

model OrganizationModule {
  id        String    @id @default(cuid())
  orgId     String
  module    ModuleKey
  enabled   Boolean   @default(true)
  source    String    @default("plan") // 'plan' | 'manual' — manual survives plan changes
  updatedAt DateTime  @updatedAt
  updatedBy String?   // platform admin's user id, set only when source = 'manual'

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, module])
  @@index([orgId])
  @@map("organization_modules")
}

// Monthly per-org AI usage counters (Gemini digitize, AssemblyAI/Claude
// transcribe) — metered separately from OrganizationModule's on/off gate.
model UsageCounter {
  id        String   @id @default(cuid())
  orgId     String
  metric    String   // 'form_digitize' | 'voice_transcribe'
  period    String   // 'YYYY-MM'
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([orgId, metric, period])
  @@map("usage_counters")
}

// ─── Models ───────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  role            UserRole
  isPlatformAdmin Boolean  @default(false) // SaaS operator flag, org-independent — set manually via psql/Prisma Studio only, never self-serve
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  facilities   UserFacility[]
  driverCycles BinCycle[]
  driverEvents EventLog[]           @relation("EventDriver")
  memberships  OrganizationMember[]

  @@map("users")
}

model UserFacility {
  id         String   @id @default(cuid())
  userId     String
  facilityId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([userId, facilityId])
  @@index([userId])
  @@index([facilityId])
  @@map("user_facilities")
}

model Facility {
  id             String       @id @default(cuid())
  name           String
  type           FacilityType @default(PROCESSING)
  address        String
  lat            Float
  lng            Float
  deletedAt      DateTime?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  users        UserFacility[]
  stations     Station[]
  bins         Bin[]          @relation("CurrentFacility")
  cycles       BinCycle[]     @relation("CycleFacility")
  deliveries   BinCycle[]     @relation("CycleDestination")
  shipments    Shipment[]     @relation("FacilityShipments")

  @@index([organizationId])
  @@map("facilities")
}

model Station {
  id         String    @id @default(cuid())
  facilityId String
  token      String    @unique
  label      String    @default("Tablet")
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  facility Facility   @relation(fields: [facilityId], references: [id])
  events   EventLog[]

  @@index([facilityId])
  @@map("stations")
}

model BinType {
  id             String   @id @default(cuid())
  organType      String
  dkHours        Int
  urgency        Urgency
  prefix         String
  masterQrCode   String?
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  bins         Bin[]

  @@unique([organizationId, organType])
  @@unique([organizationId, masterQrCode])
  @@index([organizationId])
  @@map("bin_types")
}

model Bin {
  id                String    @id @default(cuid())
  qrCode            String
  binTypeId         String
  currentFacilityId String
  status            BinStatus @default(IDLE)
  deletedAt         DateTime?
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  binType         BinType      @relation(fields: [binTypeId], references: [id])
  currentFacility Facility     @relation("CurrentFacility", fields: [currentFacilityId], references: [id])
  cycles          BinCycle[]

  @@unique([organizationId, qrCode])
  @@index([status])
  @@index([currentFacilityId])
  @@index([binTypeId])
  @@index([organizationId])
  @@map("bins")
}

model BinCycle {
  id               String            @id @default(cuid())
  binId            String
  facilityId       String
  destinationId    String?
  status           CycleStatus       @default(ACTIVE)
  startedAt        DateTime          @default(now())
  deadline         DateTime
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  driverId         String?
  vehicleId        String?
  complianceResult ComplianceResult?
  anchored         Boolean           @default(false)
  anchorTxHash     String?
  organizationId   String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  bin          Bin          @relation(fields: [binId], references: [id])
  facility     Facility     @relation("CycleFacility", fields: [facilityId], references: [id])
  destination  Facility?    @relation("CycleDestination", fields: [destinationId], references: [id])
  driver       User?        @relation(fields: [driverId], references: [id])
  events       EventLog[]

  // Note: We use application-level validation (serializable transactions) to prevent
  // duplicate ACTIVE/IN_TRANSIT cycles. A DB constraint would incorrectly prevent
  // multiple COMPLETED cycles for the same bin (which are historical records).
  // For additional DB-level safety, create a partial unique index in a migration.
  @@index([binId, status])
  @@index([status])
  @@index([deadline])
  @@index([facilityId])
  @@index([organizationId])
  @@map("bin_cycles")
}

model EventLog {
  id          String    @id @default(cuid())
  cycleId     String
  eventType   EventType
  timestamp   DateTime  @default(now())
  stationId   String?
  driverId    String?
  locationLat Float?
  locationLng Float?
  metadata    Json?
  createdAt   DateTime  @default(now())

  cycle   BinCycle @relation(fields: [cycleId], references: [id])
  station Station? @relation(fields: [stationId], references: [id])
  driver  User?    @relation("EventDriver", fields: [driverId], references: [id])

  @@index([cycleId])
  @@index([eventType])
  @@index([timestamp])
  @@map("event_logs")
}

model AnimalRegistration {
  id              String   @id @default(cuid())
  animalType      String
  breed           String?
  age             String?
  weight          String?
  ownerName       String
  healthCondition String?
  rawTranscript   String?
  organizationId  String
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("animal_registrations")
}

// ─── Employee Time Tracking ───────────────────────────────────────

model Employee {
  id             String         @id @default(cuid())
  employeeCode   String
  fullName       String
  email          String?
  phone          String?
  department     String?
  position       String?
  status         EmployeeStatus @default(ACTIVE)
  qrCode         String
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Per-employee pay rate override, in cents. NULL = fall back to the org's
  // Settings.flatHourlyRateCents. Snapshotted onto each PayrollLineItem at
  // compute time, so later changes never rewrite past runs. Visible only to
  // org ADMIN/OPS_MANAGER (stripped from reads for other roles).
  hourlyRateCents Int?

  // ─── EFT payout details ────────────────────────────────────────────────
  // Read by the payroll payout agent (separate repo, read-only on this table)
  // to send direct deposits via Zum Rails. All nullable: an employee must be
  // able to exist before submitting banking, and the payout agent treats
  // missing details as HELD — never a failed or partial payment.
  //
  // The four PII values are AES-256-GCM ciphertext at rest
  // (apps/api/src/lib/bank-crypto.ts), never logged and never returned by the
  // API — packages/db/src/client.ts omits them from every Prisma read.
  bankInstitution   String? // 3 digits, e.g. "004"
  bankTransit       String? // 5 digits, e.g. "12345"
  bankAccount       String? // 7-12 digits
  accountHolderName String? // name exactly as printed on the bank account
  accountType       String? // "CHEQUING" | "SAVINGS" — not PII, stored plain
  bankAccountLast4  String? // display-only mask source; avoids a decrypt per list row
  bankDetailsAt     DateTime? // when the employee submitted them

  // One-time self-serve bank-details link. Stored HASHED (lib/token.ts), same
  // discipline as invitation/station tokens: the raw token only ever exists in
  // the emailed link, and is cleared on use so the link burns.
  bankLinkToken     String?   @unique
  bankLinkExpiresAt DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id])
  sessions     WorkSession[]
  events       AttendanceEvent[]

  payrollLineItems  PayrollLineItem[]
  payrollExceptions PayrollException[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, qrCode])
  @@index([status])
  @@index([organizationId])
  @@map("employees")
}

model WorkSession {
  id          String    @id @default(cuid())
  employeeId  String
  checkInAt   DateTime  @default(now())
  checkOutAt  DateTime?
  durationMin Int?
  autoClosed  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id])
  events   AttendanceEvent[]

  payrollExceptions PayrollException[]

  // Used to find an employee's currently-open session quickly.
  @@index([employeeId, checkOutAt])
  @@index([checkInAt])
  @@map("work_sessions")
}

// Append-only audit trail of every scan.
model AttendanceEvent {
  id         String              @id @default(cuid())
  employeeId String
  sessionId  String
  eventType  AttendanceEventType
  scannedAt  DateTime            @default(now())
  source     String?
  createdAt  DateTime            @default(now())

  employee Employee    @relation(fields: [employeeId], references: [id])
  session  WorkSession @relation(fields: [sessionId], references: [id])

  @@index([employeeId])
  @@index([scannedAt])
  @@map("attendance_events")
}

// ─── Supplier Shipments ───────────────────────────────────────────
// A single inbound package recorded by staff when it arrives.

model Shipment {
  id             String            @id @default(cuid())
  shipmentCode   String
  supplier       String
  reference      String?
  contents       String?
  quantity       Int?
  weightKg       Float?
  condition      ShipmentCondition @default(GOOD)
  conditionNote  String?
  receivedBy     String?
  expectedAt     DateTime?
  receivedAt     DateTime          @default(now())
  facilityId     String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  facility     Facility?    @relation("FacilityShipments", fields: [facilityId], references: [id])

  @@unique([organizationId, shipmentCode])
  @@index([receivedAt])
  @@index([supplier])
  @@index([facilityId])
  @@index([organizationId])
  @@map("shipments")
}

model FormTemplate {
  id             String             @id @default(cuid())
  title          String
  description    String?
  stage          String
  formType       FormType
  schema         Json
  sourceImageUrl String?
  triggerType    FormTriggerType?
  triggerConfig  Json?
  fillFrequency  FormFillFrequency?
  isActive       Boolean            @default(true)
  sortOrder      Int                @default(0)
  organizationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([stage, isActive])
  @@index([organizationId])
  @@map("form_templates")
}

// ─── Payroll ──────────────────────────────────────────────────────
// Sits on top of the in/out tables (employees, work_sessions). Turns
// recorded minutes into money. Existing tables are unchanged.

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
  HELD
}

enum PayrollExceptionType {
  NO_CHECKOUT
  AUTO_CLOSED
}

// Company-wide config. Single row per org enforced by the unique `organizationId`.
model Settings {
  id                  String   @id @default(cuid())
  flatHourlyRateCents Int
  currency            String   @default("CAD")
  companyTimezone     String   @default("America/Toronto")
  managerEmail        String?
  organizationId      String   @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("settings")
}

// One payroll per month. UNIQUE(period) prevents paying a month twice.
model PayrollRun {
  id                String           @id @default(cuid())
  period            String // 'YYYY-MM'
  status            PayrollRunStatus @default(DRAFT)
  rateCents         Int // flat rate snapshot used for this run
  currency          String           @default("CAD")
  totalEmployees    Int              @default(0)
  totalMinutes      Int              @default(0)
  totalGrossCents   Int              @default(0)
  notes             String?
  computedAt        DateTime? // when the run's line items were calculated
  approvedAt        DateTime?
  approvedBy        String? // who approved (manager identifier)
  approvalCodeHash  String? // hashed one-time 2FA approval code
  approvalExpiresAt DateTime? // expiry for the approval code
  paidAt            DateTime?
  organizationId    String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  lineItems    PayrollLineItem[]
  exceptions   PayrollException[]

  @@unique([organizationId, period])
  @@index([status])
  @@index([organizationId])
  @@map("payroll_runs")
}

// One row per employee per run: their hours and resulting gross pay.
model PayrollLineItem {
  id           String       @id @default(cuid())
  runId        String
  employeeId   String
  minutes      Int          @default(0)
  hours        Float        @default(0)
  rateCents    Int
  grossCents   Int          @default(0)
  payoutStatus PayoutStatus @default(PENDING)
  payoutRef    String? // payout provider's transaction reference
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  run      PayrollRun @relation(fields: [runId], references: [id])
  employee Employee   @relation(fields: [employeeId], references: [id])

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([payoutStatus])
  @@map("payroll_line_items")
}

// Flagged dirty sessions (no checkout / auto-closed) held back from auto-pay.
model PayrollException {
  id         String               @id @default(cuid())
  runId      String
  employeeId String
  sessionId  String
  type       PayrollExceptionType
  resolved   Boolean              @default(false)
  resolvedAt DateTime?
  note       String?
  createdAt  DateTime             @default(now())

  run      PayrollRun  @relation(fields: [runId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  session  WorkSession @relation(fields: [sessionId], references: [id])

  @@index([runId])
  @@index([employeeId])
  @@map("payroll_exceptions")
}

// Owned by the payroll payout agent (separate repo), declared here only so
// `prisma migrate` doesn't report the live table as drift. bin-tracker never
// reads or writes it — the payout agent stores the Zum Rails User id it
// created for an employee on their first payout.
// ─── Payroll audit log ───────────────────────────────────────────────────────
// Money-adjacent config changes (org rate/settings, per-employee rates, module
// toggles) recorded with who/old/new. Append-only; no relations so entries
// survive any future cleanup of the rows they describe. Write-only for now —
// queried directly when investigating; a viewer UI can come later.
model PayrollAuditLog {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String // user id of the admin who made the change
  action    String // 'settings.update' | 'employee.setHourlyRate' | 'module.toggle'
  targetId  String? // employeeId for rate changes, ModuleKey for toggles
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("payroll_audit_logs")
}

model ZumPayee {
  employeeId String   @id
  zumUserId  String   @unique
  // timestamptz(6), matching the table the payout agent already created — a
  // bare DateTime would map to timestamp(3) and reintroduce the drift this
  // model exists to remove.
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@map("zum_payees")
}
