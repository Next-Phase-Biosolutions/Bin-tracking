# ─────────────────────────────────────────────────────────────────
#  .env.local.example — Recommended local development setup
#
#  workflow: each developer runs their OWN local Postgres.
#  Production lives on Supabase — developers never connect to it.
#
#  Quick start:
#   1. cp .env.local.example .env
#   2. docker compose up -d
#   3. pnpm install
#   4. pnpm db:generate
#   5. pnpm db:migrate
#   6. pnpm db:seed:local
#   7. pnpm dev
#
#  Auth is disabled — the API auto-injects admin@bintracker.com.
#  See docs/database-setup.md for schema changes and PR workflow.
# ─────────────────────────────────────────────────────────────────

# ─── Database (local Docker Postgres — recommended) ───────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bin_tracker?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/bin_tracker?schema=public"

# Native Postgres alternative (no Docker):
# DATABASE_URL="postgresql://postgres@localhost:5432/bin_tracker?schema=public"
# DIRECT_URL="postgresql://postgres@localhost:5432/bin_tracker?schema=public"

# ─── Supabase — NOT required in local mode ───────────────────────
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ─── Auth bypass — REQUIRED for local mode ───────────────────────
# NEVER set this to true in production.
DISABLE_AUTH=true
VITE_DISABLE_AUTH=true

# ─── Seed safety guard ───────────────────────────────────────────
# Prevents accidental data wipe if seed is run a second time.
# Set to false only when you intentionally want a full re-seed.
SEED_ONLY_IF_EMPTY=true

# ─── API Server ──────────────────────────────────────────────────
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="debug"

# ─── CORS ────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# ─── Cardano — optional, leave blank to skip blockchain features ─
BLOCKFROST_API_KEY=""
CARDANO_NETWORK="preprod"
CARDANO_NFT_IMAGE_CID=""

VITE_BLOCKFROST_API_KEY=""
VITE_CARDANO_NETWORK="preprod"
VITE_CARDANO_SCAN_BASE_URL="https://preprod.cardanoscan.io/transaction"

# ─── Test tokens — not needed in local mode ──────────────────────
VITE_TEST_DRIVER_TOKEN=""
VITE_TEST_ADMIN_TOKEN=""

# ─── Form photo digitization (Gemini) ───────────────────
GEMINI_API_KEY=""
FORM_DIGITIZE_MODEL="gemini-2.0-flash"

# ─── Voice field fill (Claude + AssemblyAI) ─────────────
ANTHROPIC_API_KEY=""
ASSEMBLYAI_API_KEY=""
