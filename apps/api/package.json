{
    "name": "@bin-tracker/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=../../.env src/server.ts",
        "build": "tsc",
        "start": "tsx src/server.ts",
        "typecheck": "tsc --noEmit",
        "lint": "ESLINT_USE_FLAT_CONFIG=true pnpm exec eslint -c scripts/lint-eslint.config.mjs src/",
        "lint:fix": "ESLINT_USE_FLAT_CONFIG=true pnpm exec eslint -c scripts/lint-eslint.config.mjs src/ --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.87.0",
        "@bin-tracker/db": "workspace:*",
        "@bin-tracker/types": "workspace:*",
        "@bin-tracker/validators": "workspace:*",
        "@fastify/cors": "^10.0.0",
        "@fastify/helmet": "^13.0.0",
        "@fastify/rate-limit": "^10.2.0",
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^7.4.0",
        "@supabase/ssr": "^0.8.0",
        "@trpc/server": "^11.0.0",
        "assemblyai": "^4.29.0",
        "fastify": "^5.2.0",
        "fastify-raw-body": "^5.0.0",
        "jose": "^6.1.3",
        "pino": "^9.6.0",
        "stripe": "^22.3.1",
        "superjson": "^2.2.0",
        "tsx": "^4.19.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "pino-pretty": "^13.1.3",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    }
}