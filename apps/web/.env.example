# Facility app (Next.js) — copy to .env.local and fill in. .env.local is gitignored.

# Render API base URL (tRPC client hits ${NEXT_PUBLIC_API_URL}/trpc)
NEXT_PUBLIC_API_URL=https://bin-tracker-api-XXXX.onrender.com

# Supabase (browser-safe anon key)
NEXT_PUBLIC_SUPABASE_URL=https://saqkyiilublutwuswulk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integration: true = API injects an admin user (no login). Set false for real Supabase login.
NEXT_PUBLIC_DISABLE_AUTH=true
