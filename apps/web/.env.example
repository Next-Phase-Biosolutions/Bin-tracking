# Facility app (Vite). Values are loaded from the monorepo-root .env (envDir).
# API base URL — tRPC client hits ${VITE_API_URL}/trpc
VITE_API_URL=http://localhost:3001
# Supabase (browser-safe anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# true = API injects an admin user (no login). Set false for real Supabase login.
VITE_DISABLE_AUTH=true
