# ─────────────────────────────────────────────────────────────────
#  Bin Tracker — environment template
#
#   workflow: each developer runs their OWN local Postgres.
#  Production lives on Supabase — developers never connect to it.
#
#  Quick start (local dev):
#   1. Install PostgreSQL 16 (see README)
#   2. createdb bin_tracker
#   3. cp .env.example .env
#   4. pnpm install && pnpm db:generate && pnpm db:migrate && pnpm db:seed:local
#   5. pnpm dev
#
#  Auth is disabled locally (DISABLE_AUTH=true). See docs/database-setup.md.
# ─────────────────────────────────────────────────────────────────

# ─── Database (local Postgres) ───────────────────────────────────
# Default: local superuser, no password (common on Mac Homebrew installs).
# If you set a password during install, include it in the URL.
DATABASE_URL="postgresql://postgres@localhost:5432/bin_tracker?schema=public"
DIRECT_URL="postgresql://postgres@localhost:5432/bin_tracker?schema=public"

# With password (Windows / custom setup):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bin_tracker?schema=public"
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bin_tracker?schema=public"

# PRODUCTION (Supabase) — set in GitHub / Render secrets only, never commit:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres"

# ─── Seed safety ─────────────────────────────────────────────────
# true = skip seed if data already exists (recommended locally)
# Production bootstrap: SEED_ONLY_IF_EMPTY=true, NODE_ENV=production
SEED_ONLY_IF_EMPTY="true"
# Dev-only full wipe + re-seed (NEVER set in production):
# SEED_FORCE="true"

# ─── Supabase (optional locally — leave blank with DISABLE_AUTH=true) ──
# Fill in only if testing real JWT login against a personal dev project.
# Keep DATABASE_URL pointed at local Postgres — never use prod Supabase DB URL.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ─── Auth ────────────────────────────────────────────────────────
# Local dev: true (API auto-injects admin user). Production: false.
DISABLE_AUTH=true
VITE_DISABLE_AUTH=true

# ─── API Server ──────────────────────────────────────────────────
PORT=3001
HOST="0.0.0.0"
NODE_ENV="development"
LOG_LEVEL="debug"

# ─── CORS ────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# ─── Billing (Stripe) ─────────────────────────────────────────────
# Free launch period: leave BILLING_ENABLED=false and STRIPE_SECRET_KEY blank.
# The Stripe integration ships fully built but stays inert until this flips.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""
APP_URL="http://localhost:3000"

# ─── Marketing site (apps/marketing) ──────────────────────────────
# Base URL of the app site — where login/signup hand off the Supabase
# session to (via URL hash) after a successful sign-in/sign-up.
VITE_APP_URL="http://localhost:3000"

# ─── Web app (apps/web) ────────────────────────────────────────────
# Base URL of the marketing site — login/signup live there, not in this
# app, so an unauthenticated visitor gets bounced out to this URL instead
# of an in-app login form.
VITE_MARKETING_URL="http://localhost:3002"

# ─── Email (Resend — team invitations) ────────────────────────────
# Leave blank locally. lib/email.ts is a lazy singleton like getStripe() —
# a blank RESEND_API_KEY does not crash the server at boot, only invitation
# sends attempted while it's unset (invitation.create will throw).
RESEND_API_KEY=""
EMAIL_FROM=""

# ─── Sensor integration (EcoSafeSense — backfill/poll script) ─────
# Required only to run `pnpm --filter @bin-tracker/db backfill:sensors`
# (packages/db/src/backfill-sensors.ts). Leave blank otherwise.
ECOSAFESENSE_BASE_URL=""
ECOSAFESENSE_CLIENT_ID=""
ECOSAFESENSE_CLIENT_SECRET=""
ECOSAFESENSE_DEVICE_ID=""
# Facility (cuid) the device row gets attached to; org defaults to the
# 'default' org slug — override with SENSOR_ORG_SLUG if needed.
SENSOR_FACILITY_ID=""
# SENSOR_ORG_SLUG="default"
# SENSOR_DEVICE_LABEL=""
# ECOSAFESENSE_BACKFILL_LOOKBACK_DAYS="30"

# ─── Background jobs (BullMQ + Redis) ─────────────────────────────
# Leave blank locally. lib/queue.ts is a lazy singleton like getStripe() — a
# blank REDIS_URL does not crash the server at boot, only enqueuing/polling a
# heavy job (e.g. payroll.computeRun) attempted while it's unset. The worker
# process (src/worker.ts, run via `pnpm dev:worker`/`start:worker`) requires
# REDIS_URL to start, since talking to Redis is its entire job.
REDIS_URL=""

# ─── Error tracking (Sentry) ───────────────────────────────────────
# Leave blank locally. lib/sentry.ts is a lazy, env-gated integration like
# lib/stripe.ts — a blank DSN means Sentry.init() is never called, so nothing
# is captured and the server/app boot cleanly either way.
SENTRY_DSN=""
VITE_SENTRY_DSN=""

# ─── Cardano (optional) ──────────────────────────────────────────
BLOCKFROST_API_KEY=""
CARDANO_NETWORK="preprod"
CARDANO_NFT_IMAGE_CID=""

VITE_BLOCKFROST_API_KEY=""
VITE_CARDANO_NETWORK="preprod"
VITE_CARDANO_SCAN_BASE_URL="https://preprod.cardanoscan.io/transaction"

# ─── Form photo digitization (Gemini) ─────────────────────────────
GEMINI_API_KEY=""
FORM_DIGITIZE_MODEL="gemini-2.0-flash"

# ─── Voice field fill (Claude + AssemblyAI) ───────────────────────
ANTHROPIC_API_KEY=""
ASSEMBLYAI_API_KEY=""

# ─── Test tokens (optional — not needed with DISABLE_AUTH=true) ───
VITE_TEST_DRIVER_TOKEN=""
VITE_TEST_ADMIN_TOKEN=""
