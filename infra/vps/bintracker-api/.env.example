# Copy to /opt/bin-tracker/infra/vps/bintracker-api/.env on the VPS. chmod 600.
# See kvmplan.md §11 — one .env per concern, never a shared file, never committed.

NODE_ENV="production"
PORT=3001
HOST="0.0.0.0"
LOG_LEVEL="info"

# Supabase production (pooler for the app, direct for migrations — see deployment-guide.md)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres"

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Required in production: the API verifies Supabase JWTs locally with this
# secret (Supabase dashboard → Settings → API → JWT Secret) instead of a
# network round-trip per request.
SUPABASE_JWT_SECRET=""

# ─── BullMQ heavy-jobs queue (payroll.computeRun, form.digitizeFromPhoto) ───
# `redis` is the service name in this directory's docker-compose.yml (api_net).
# Both API colors and the worker container need this.
REDIS_URL="redis://redis:6379"

# Auth bypass must never be set in production (apps/api/src/lib/auth-flags.ts hard-disables
# it anyway when NODE_ENV=production, but keep it entirely unset here per kvmplan.md §11).
# DISABLE_AUTH is intentionally omitted.

CORS_ORIGIN="https://app.<your-domain>"
# APP_URL is the web origin; NFC registration links are ${APP_URL}/app/register?token=…
APP_URL="https://app.<your-domain>"

# ─── NFC attendance (docs/nfc-attendance) ─────────────────────────────────────────────
# The phone pages reach this API through a Netlify rewrite (/trpc/* -> this host), so every phone
# tap arrives from Netlify's edge, not the phone. The global per-IP limit (default 100/min) is then
# effectively shared by all phones: raise it, and measure on staging before relying on it.
# RATE_LIMIT_MAX="600"
# Set only after confirming, on the real Netlify -> Caddy chain, that this header reaches the API intact
# (see docs/nfc-attendance "Rate limits"). Then every limiter keys on the real client, not the proxy.
# CLIENT_IP_HEADER="x-nf-client-connection-ip"
# DB_POOL_MAX caps the pg pool (default 10). Match it to the pooler's connection limit.
# DB_POOL_MAX="20"

# ─── Billing (Stripe) — see SAAS.md Task 13. Leave BILLING_ENABLED=false during free launch. ───
BILLING_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# ─── Cardano anchoring ───
BLOCKFROST_API_KEY=""
CARDANO_NETWORK="mainnet"
CARDANO_NFT_IMAGE_CID=""

# ─── Form photo digitization (Gemini) ───
GEMINI_API_KEY=""
FORM_DIGITIZE_MODEL="gemini-2.0-flash"

# ─── Voice field fill (Claude + AssemblyAI) ───
ANTHROPIC_API_KEY=""
ASSEMBLYAI_API_KEY=""

# ─── Invitations (SAAS.md Task 19) ───
RESEND_API_KEY=""
EMAIL_FROM=""

# ─── Monitoring ───
SENTRY_DSN=""
