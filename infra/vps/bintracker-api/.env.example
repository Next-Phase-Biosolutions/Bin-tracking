# Copy to /opt/bin-tracker/infra/vps/bintracker-api/.env on the VPS. chmod 600.
# See kvmplan.md §11 — one .env per concern, never a shared file, never committed.

NODE_ENV="production"
PORT=3001
HOST="0.0.0.0"
LOG_LEVEL="info"

# Supabase production (pooler for the app, direct for migrations — see deployment-guide.md)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@db.[ref].supabase.co:5432/postgres"

SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Auth bypass must never be set in production (apps/api/src/lib/auth-flags.ts hard-disables
# it anyway when NODE_ENV=production, but keep it entirely unset here per kvmplan.md §11).
# DISABLE_AUTH is intentionally omitted.

CORS_ORIGIN="https://app.<your-domain>"
APP_URL="https://app.<your-domain>"

# ─── Billing (Stripe) — see SAAS.md Task 13. Leave BILLING_ENABLED=false during free launch. ───
BILLING_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ENTERPRISE=""

# ─── Cardano anchoring ───
BLOCKFROST_API_KEY=""
CARDANO_NETWORK="mainnet"
CARDANO_NFT_IMAGE_CID=""

# ─── Form photo digitization (Gemini) ───
GEMINI_API_KEY=""
FORM_DIGITIZE_MODEL="gemini-2.0-flash"

# ─── Voice field fill (Claude + AssemblyAI) ───
ANTHROPIC_API_KEY=""
ASSEMBLYAI_API_KEY=""

# ─── Invitations (SAAS.md Task 19) ───
RESEND_API_KEY=""
EMAIL_FROM=""

# ─── Monitoring ───
SENTRY_DSN=""
